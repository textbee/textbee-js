{
  "name": "@textbee/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript SDK for textbee.dev, the open source SMS gateway",
  "license": "MIT",
  "packageManager": "pnpm@9.14.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textbee/textbee-js.git"
  },
  "homepage": "https://textbee.dev",
  "bugs": {
    "url": "https://github.com/textbee/textbee-js/issues"
  },
  "keywords": [
    "sms",
    "sms-gateway",
    "textbee",
    "android"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
